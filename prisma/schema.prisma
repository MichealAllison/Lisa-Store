generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String      @default("")
  price       Int // kobo
  images      String // JSON array of URLs
  sizes       String // JSON array of variant labels, e.g. ["S","M","L"]
  stock       Int         @default(0)
  inStock     Boolean     @default(true)
  isNew       Boolean     @default(false)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([slug])
}

model Order {
  id           String      @id @default(cuid())
  reference    String      @unique
  status       String      @default("pending_whatsapp")
  // statuses: pending_whatsapp | confirmed | fulfilled | paid | cancelled | failed
  channel      String      @default("whatsapp") // orders are always placed over WhatsApp
  customerName String
  customerPhone String
  customerEmail String?
  address      String
  total        Int // kobo
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  size      String?
  quantity  Int
  price     Int
}

model Setting {
  key   String @id
  value String
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
