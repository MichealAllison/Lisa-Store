########################################
# Lisa storefront — environment variables
# Copy to `.env` and fill in.
########################################

# Database — PostgreSQL (Vercel Postgres / Neon / Supabase / Railway)
# For local-only work you can switch prisma/schema.prisma to sqlite and use "file:./dev.db"
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth (admin dashboard login)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# Seed admin account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@lisaties.com"
ADMIN_PASSWORD="change-me"

# WhatsApp — the ONLY checkout channel. International format, no "+".
# Falls back to Admin → Settings when set there.
NEXT_PUBLIC_WHATSAPP_NUMBER="2348012345678"

# Branding (optional — defaults to "Lisa" in src/lib/site.ts)
NEXT_PUBLIC_SITE_NAME="Lisa"

# Public site URL (sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary (optional) — when set, admin image uploads go to Cloudinary;
# otherwise they fall back to local /public/uploads (dev only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# NOTE: there is no payment gateway integration. Checkout hands off to WhatsApp,
# so no gateway keys are read anywhere in the app.
